# Copy to .env.local and fill in. .env.local is gitignored.
ANTHROPIC_API_KEY=
# Hard cap on total Claude spend for this app, in USD. Calls are refused past this.
BUDGET_USD=10
# Max Claude calls per minute.
CLAUDE_RATE_LIMIT_PER_MIN=20
# Model for explainers (mood expansion always uses Haiku). claude-opus-5-5 ($4/$20 per 1M tokens), claude-sonnet-5-5 ($2/$10), claude-haiku-5-5 ($0.10/$0.50)
CLAUDE_MODEL=claude-opus-5-5
# Set to 1 for a fully offline app (fixture papers, no arXiv, no Claude).
# RABBITHOLE_FIXTURES=1
# With fixtures on, serve this larger frozen pool (50 papers a round) instead, e.g. for load tests.
# RABBITHOLE_FIXTURES_POOL=eval/rank/pool.json
# Set to "off" to never call Claude (a public deploy): cached explainers only, keyword moods.
# RABBITHOLE_CLAUDE=off
# Postgres for the spend ledger and caches (safe with several server instances).
# Without it, everything stays in data/ (one process only). Local: docker compose up -d db
# DATABASE_URL=postgres://rabbithole:rabbithole@localhost:54329/rabbithole
# Where local files go (default ./data). Point at /tmp on a read-only filesystem.
# RABBITHOLE_DATA_DIR=/tmp/data
# Where the embedding model lives (default ./data/models); it can be read-only.
# RABBITHOLE_MODELS_DIR=/var/task/data/models
