{
  "name": "rabbithole",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke:arxiv": "node --conditions=react-server --import tsx scripts/arxiv-smoke.ts",
    "fixtures": "node --conditions=react-server --import tsx scripts/make-fixtures.ts",
    "test:e2e": "playwright test",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "smoke:rank": "node --conditions=react-server --import tsx scripts/rank-smoke.ts",
    "eval:rank:build": "node --conditions=react-server --import tsx scripts/eval/rank-build.ts",
    "eval:rank": "node --conditions=react-server --import tsx scripts/eval/rank.ts",
    "eval:faithfulness": "node --conditions=react-server --import tsx scripts/eval/faithfulness.ts",
    "load:feed": "node scripts/load/feed.mjs",
    "db:migrate": "node --conditions=react-server --import tsx scripts/db/setup.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/db/setup.ts --seed",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://rabbithole:rabbithole@localhost:54329/rabbithole} node --import tsx --test src/lib/db/db.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@huggingface/transformers": "^4.3.2",
    "fast-xml-parser": "^5.12.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autocannon": "^9.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
